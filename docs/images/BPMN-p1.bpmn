  <collaboration id="Collaboration_GestaoTorneios">
    <participant id="Participant_Organizador" name="Gestão de Torneios" processRef="Process_Organizador" />
  </collaboration>
  <process id="Process_Organizador" isExecutable="false">
    <laneSet id="LaneSet_Organizador">
      <lane id="Lane_03xvxgq" name="Organizador">
        <flowNodeRef>StartEvent_Org</flowNodeRef>
        <flowNodeRef>Task_AcessarLista</flowNodeRef>
        <flowNodeRef>Gateway_Crud</flowNodeRef>
        <flowNodeRef>Task_EditarTorneio</flowNodeRef>
        <flowNodeRef>Service_AtualizarTorneio</flowNodeRef>
        <flowNodeRef>EndEvent_TorneioAtualizado</flowNodeRef>
        <flowNodeRef>Task_ConfirmarExclusao</flowNodeRef>
        <flowNodeRef>Service_ExcluirTorneio</flowNodeRef>
