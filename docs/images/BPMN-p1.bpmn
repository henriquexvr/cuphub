    <sequenceFlow id="Flow_ToAtualizar" sourceRef="Task_EditarTorneio" targetRef="Service_AtualizarTorneio" />
    <sequenceFlow id="Flow_ToEndEdicao" sourceRef="Service_AtualizarTorneio" targetRef="EndEvent_TorneioAtualizado" />
    <sequenceFlow id="Flow_0vnuq4j" sourceRef="Event_0sxa8ae" targetRef="Task_AcessarListaMod" />
    <sequenceFlow id="Flow_ToRevisar" sourceRef="Task_AcessarListaMod" targetRef="Task_RevisarTorneio" />
