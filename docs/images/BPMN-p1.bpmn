    <sequenceFlow id="Flow_Reprovar" name="Reprovar" sourceRef="Gateway_DecisaoMod" targetRef="Service_ReprovarTorneio" />
    <sequenceFlow id="Flow_ToNotifReprov" sourceRef="Service_ReprovarTorneio" targetRef="Send_NotifReprovado" />
    <sequenceFlow id="Flow_ToEndReprovado" sourceRef="Send_NotifReprovado" targetRef="EndEvent_Reprovado" />
    <sequenceFlow id="Flow_ToExcluir" sourceRef="Task_ConfirmarExclusao" targetRef="Service_ExcluirTorneio" />
    <sequenceFlow id="Flow_ToEndExclusao" sourceRef="Service_ExcluirTorneio" targetRef="EndEvent_TorneioExcluido" />
    <sequenceFlow id="Flow_ToDefinirRegras" sourceRef="Task_PreencherIdentificacao" targetRef="Task_DefinirRegras" />
    <sequenceFlow id="Flow_ToSalvar" sourceRef="Task_DefinirRegras" targetRef="Service_SalvarTorneio" />
    <sequenceFlow id="Flow_ToEndCriacao" sourceRef="Service_SalvarTorneio" targetRef="EndEvent_TorneioSubmetido" />
    <sequenceFlow id="Flow_1ddawts" sourceRef="Service_SalvarTorneio" targetRef="Event_0sxa8ae" />
