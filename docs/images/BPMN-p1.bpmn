        <flowNodeRef>Task_PreencherIdentificacao</flowNodeRef>
        <flowNodeRef>Task_DefinirRegras</flowNodeRef>
        <flowNodeRef>EndEvent_TorneioSubmetido</flowNodeRef>
        <flowNodeRef>Service_SalvarTorneio</flowNodeRef>
      </lane>
    <lane id="Lane_14bbaw7" name="Moderador">
      <flowNodeRef>Task_AcessarListaMod</flowNodeRef>
      <flowNodeRef>Task_RevisarTorneio</flowNodeRef>
      <flowNodeRef>Gateway_DecisaoMod</flowNodeRef>
      <flowNodeRef>Service_AprovarTorneio</flowNodeRef>
      <flowNodeRef>Send_NotifAprovado</flowNodeRef>
      <flowNodeRef>EndEvent_Aprovado</flowNodeRef>
      <flowNodeRef>Service_ReprovarTorneio</flowNodeRef>
      <flowNodeRef>Send_NotifReprovado</flowNodeRef>
      <flowNodeRef>EndEvent_Reprovado</flowNodeRef>
    </lane>
    </laneSet>
    <startEvent id="StartEvent_Org" name="Início">
      <outgoing>Flow_OrgStart</outgoing>
    </startEvent>
    <userTask id="Task_AcessarLista" name="Acessar tela de gestão de torneios">
      <incoming>Flow_OrgStart</incoming>
      <outgoing>Flow_ToGwCrud</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_Crud" name="Ação selecionada?">
      <incoming>Flow_ToGwCrud</incoming>
      <outgoing>Flow_Criar</outgoing>
      <outgoing>Flow_Editar</outgoing>
      <outgoing>Flow_Excluir</outgoing>
    </exclusiveGateway>
    <userTask id="Task_EditarTorneio" name="Editar dados do torneio">
      <incoming>Flow_Editar</incoming>
      <outgoing>Flow_ToAtualizar</outgoing>
    </userTask>
    <serviceTask id="Service_AtualizarTorneio" name="Atualizar torneio no banco de dados">
      <incoming>Flow_ToAtualizar</incoming>
      <outgoing>Flow_ToEndEdicao</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_12o1g7m">
        <targetRef>DataStoreReference_15rktod</targetRef>
      </dataOutputAssociation>
    </serviceTask>
    <endEvent id="EndEvent_TorneioAtualizado" name="Torneio atualizado">
      <incoming>Flow_ToEndEdicao</incoming>
    </endEvent>
    <userTask id="Task_AcessarListaMod" name="Acessar tela de gestão de torneios">
      <incoming>Flow_0vnuq4j</incoming>
      <outgoing>Flow_ToRevisar</outgoing>
    </userTask>
    <userTask id="Task_RevisarTorneio" name="Revisar torneio pendente">
      <incoming>Flow_ToRevisar</incoming>
      <outgoing>Flow_0bxkz38</outgoing>
    </userTask>
    <userTask id="Task_ConfirmarExclusao" name="Confirmar exclusão do torneio">
      <incoming>Flow_Excluir</incoming>
      <outgoing>Flow_ToExcluir</outgoing>
    </userTask>
    <serviceTask id="Service_ExcluirTorneio" name="Excluir torneio do banco de dados">
      <incoming>Flow_ToExcluir</incoming>
      <outgoing>Flow_ToEndExclusao</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_179odzl">
        <targetRef>DataStoreReference_15rktod</targetRef>
      </dataOutputAssociation>
    </serviceTask>
    <endEvent id="EndEvent_TorneioExcluido" name="Torneio excluído">
      <incoming>Flow_ToEndExclusao</incoming>
    </endEvent>
    <userTask id="Task_PreencherIdentificacao" name="Preencher identificação do torneio">
      <incoming>Flow_Criar</incoming>
      <outgoing>Flow_ToDefinirRegras</outgoing>
    </userTask>
    <userTask id="Task_DefinirRegras" name="Definir regras do torneio">
      <incoming>Flow_ToDefinirRegras</incoming>
      <outgoing>Flow_ToSalvar</outgoing>
    </userTask>
    <endEvent id="EndEvent_TorneioSubmetido" name="Torneio aguardando aprovação">
      <incoming>Flow_ToEndCriacao</incoming>
    </endEvent>
    <intermediateCatchEvent id="Event_0sxa8ae" name="Torneio submetido para aprovação">
      <incoming>Flow_1ddawts</incoming>
      <outgoing>Flow_0vnuq4j</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0vwsujf" />
    </intermediateCatchEvent>
    <dataStoreReference id="DataStoreReference_15rktod" name="Banco de Dados" />
    <serviceTask id="Service_SalvarTorneio" name="Salvar torneio (status: Aguardando Aprovação)">
      <incoming>Flow_ToSalvar</incoming>
      <outgoing>Flow_ToEndCriacao</outgoing>
      <outgoing>Flow_1ddawts</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0vrm4l1">
        <targetRef>DataStoreReference_15rktod</targetRef>
      </dataOutputAssociation>
    </serviceTask>
    <sendTask id="Send_NotifAprovado" name="Notificar organizador (aprovado)">
      <incoming>Flow_ToNotifAprov</incoming>
      <outgoing>Flow_ToEndAprovado</outgoing>
    </sendTask>
    <endEvent id="EndEvent_Aprovado" name="Moderação concluída (Aprovado)">
      <incoming>Flow_ToEndAprovado</incoming>
    </endEvent>
    <serviceTask id="Service_AprovarTorneio" name="Atualizar status para approved">
      <incoming>Flow_0bxkz38</incoming>
      <outgoing>Flow_ToNotifAprov</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_1hf1fn4">
        <targetRef>DataStoreReference_15rktod</targetRef>
      </dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="Gateway_DecisaoMod" name="Aprovar ou Reprovar?">
      <incoming>Flow_ToGwMod</incoming>
      <outgoing>Flow_Aprovar</outgoing>
      <outgoing>Flow_Reprovar</outgoing>
    </exclusiveGateway>
    <serviceTask id="Service_ReprovarTorneio" name="Atualizar status para rejected">
      <incoming>Flow_Reprovar</incoming>
      <outgoing>Flow_ToNotifReprov</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_Reprov">
        <targetRef>DataStoreReference_15rktod</targetRef>
      </dataOutputAssociation>
    </serviceTask>
    <sendTask id="Send_NotifReprovado" name="Notificar organizador (reprovado)">
      <incoming>Flow_ToNotifReprov</incoming>
      <outgoing>Flow_ToEndReprovado</outgoing>
    </sendTask>
    <endEvent id="EndEvent_Reprovado" name="Moderação concluída (Reprovado)">
      <incoming>Flow_ToEndReprovado</incoming>
    </endEvent>
    <sequenceFlow id="Flow_OrgStart" sourceRef="StartEvent_Org" targetRef="Task_AcessarLista" />
    <sequenceFlow id="Flow_ToGwCrud" sourceRef="Task_AcessarLista" targetRef="Gateway_Crud" />
